+/* =====================================================================
+   BioClaw local-web UI — simple, single-panel layout
+   - No side-by-side panels (chat OR trace, via tab)
+   - Thread rail and settings are slide-in drawers
+   - Default: light theme, emerald accent
+   ===================================================================== */
+
+/* ─────────── Design tokens ─────────── */
+
+:root {
+  --bg:              #FAFAF7;
+  --surface:         #FFFFFF;
+  --surface-raised:  #F5F5F0;
+  --surface-soft:    #EFEFE8;
+  --border:          rgba(24, 35, 32, 0.08);
+  --border-strong:   rgba(24, 35, 32, 0.14);
+  --ink:             #151C1A;
+  --ink-soft:        #384641;
+  --muted:           #6B7672;
+  --muted-soft:      #97A09B;
+  --accent:          #059669;
+  --accent-hover:    #047857;
+  --accent-soft:     rgba(5, 150, 105, 0.10);
+  --accent-muted:    rgba(5, 150, 105, 0.06);
+  --user:            #2563EB;
+  --user-soft:       rgba(37, 99, 235, 0.08);
+  --user-muted:      rgba(37, 99, 235, 0.06);
+  --warn:            #DC2626;
+  --warn-soft:       rgba(220, 38, 38, 0.08);
+  --info:            #0EA5E9;
+  --info-soft:       rgba(14, 165, 233, 0.08);
+  --purple:          #8B5CF6;
+  --purple-soft:     rgba(139, 92, 246, 0.10);
+  --amber:           #D97706;
+  --amber-soft:      rgba(217, 119, 6, 0.10);
+
+  --radius:          14px;
+  --radius-sm:       10px;
+  --radius-lg:       18px;
+  --radius-pill:     999px;
+
+  --shadow-xs:       0 1px 2px rgba(15, 23, 42, 0.04);
+  --shadow-sm:       0 2px 6px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
+  --shadow-md:       0 8px 24px rgba(15, 23, 42, 0.08), 0 2px 4px rgba(15, 23, 42, 0.04);
+  --shadow-lg:       0 20px 48px rgba(15, 23, 42, 0.12), 0 4px 8px rgba(15, 23, 42, 0.06);
+  --shadow-drawer:   0 20px 48px rgba(15, 23, 42, 0.18);
+  --backdrop:        rgba(15, 23, 42, 0.24);
+
+  --font:            'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'HarmonyOS Sans SC', 'Microsoft YaHei', sans-serif;
+  --font-mono:       'JetBrains Mono', ui-monospace, 'SFMono-Regular', Consolas, monospace;
+
+  --header-h:        56px;
+  --content-max:     760px;
+  --rail-w:          280px;
+  --trace-w:         0px;
+  --drawer-w:        420px;
+
+  color-scheme: light;
+}
+
+/* ─────────────── Themes ───────────────
+   One picker: each theme is fully self-contained (its own light/dark + accent).
+   Default (no data-theme) = emerald-light. */
+
+/* Light: Ocean — soft blue */
+:root[data-theme="ocean"] {
+  --bg: #F1F7FA; --surface: #FFFFFF; --surface-raised: #EAF2F7; --surface-soft: #DDE8EF;
+  --border: rgba(8, 47, 73, 0.10); --border-strong: rgba(8, 47, 73, 0.16);
+  --ink: #0C2436; --ink-soft: #244563; --muted: #587088; --muted-soft: #8B9FB1;
+  --accent: #0891B2; --accent-hover: #0E7490; --accent-soft: rgba(8,145,178,.10); --accent-muted: rgba(8,145,178,.06);
+  color-scheme: light;
+}
+
+/* Light: Sakura — warm rose */
+:root[data-theme="sakura"] {
+  --bg: #FBF3F5; --surface: #FFFFFF; --surface-raised: #F5E8EC; --surface-soft: #EFDCE2;
+  --border: rgba(76, 5, 25, 0.10); --border-strong: rgba(76, 5, 25, 0.16);
+  --ink: #2A0814; --ink-soft: #4D1A2A; --muted: #7C5460; --muted-soft: #A88A93;
+  --accent: #E11D48; --accent-hover: #BE123C; --accent-soft: rgba(225,29,72,.10); --accent-muted: rgba(225,29,72,.06);
+  color-scheme: light;
+}
+
+/* Light: Cream — paper-like, warm beige */
+:root[data-theme="cream"] {
+  --bg: #FBF6E9; --surface: #FFFCF3; --surface-raised: #F4EDD9; --surface-soft: #ECE3CB;
+  --border: rgba(86, 64, 18, 0.12); --border-strong: rgba(86, 64, 18, 0.18);
+  --ink: #2A1E08; --ink-soft: #4F3D1E; --muted: #7A6948; --muted-soft: #A39376;
+  --accent: #B45309; --accent-hover: #92400E; --accent-soft: rgba(180,83,9,.12); --accent-muted: rgba(180,83,9,.07);
+  color-scheme: light;
+}
+
+/* Light: Mono — minimal black/white, no chromatic accent */
+:root[data-theme="mono-light"] {
+  --bg: #FAFAFA; --surface: #FFFFFF; --surface-raised: #F0F0F0; --surface-soft: #E5E5E5;
+  --border: rgba(0, 0, 0, 0.10); --border-strong: rgba(0, 0, 0, 0.18);
+  --ink: #0A0A0A; --ink-soft: #2C2C2C; --muted: #6E6E6E; --muted-soft: #999999;
+  --accent: #171717; --accent-hover: #000000; --accent-soft: rgba(0,0,0,.07); --accent-muted: rgba(0,0,0,.04);
+  color-scheme: light;
+}
+
+/* Dark: Midnight — neutral dark, emerald accent (the original dark) */
+:root[data-theme="midnight"] {
+  --bg: #0A0A0B; --surface: #141416; --surface-raised: #1A1A1D; --surface-soft: #212125;
+  --border: rgba(255, 255, 255, 0.06); --border-strong: rgba(255, 255, 255, 0.12);
+  --ink: #EDEDEF; --ink-soft: #C8C9CD; --muted: #8B8C93; --muted-soft: #5E5F66;
+  --accent: #10B981; --accent-hover: #34D399; --accent-soft: rgba(16,185,129,.14); --accent-muted: rgba(16,185,129,.07);
+  --backdrop: rgba(0, 0, 0, 0.6);
+  --shadow-xs: 0 1px 2px rgba(0,0,0,.3); --shadow-sm: 0 2px 6px rgba(0,0,0,.35);
+  --shadow-md: 0 8px 24px rgba(0,0,0,.4); --shadow-lg: 0 20px 48px rgba(0,0,0,.5);
+  --shadow-drawer: 0 20px 48px rgba(0,0,0,.6);
+  color-scheme: dark;
+}
+
+/* Dark: Slate — blue-gray dark, cyan accent */
+:root[data-theme="slate"] {
+  --bg: #0B1218; --surface: #141C25; --surface-raised: #1A2331; --surface-soft: #222D3D;
+  --border: rgba(186, 230, 253, 0.07); --border-strong: rgba(186, 230, 253, 0.14);
+  --ink: #E2E8F0; --ink-soft: #BCC8D7; --muted: #788FA6; --muted-soft: #4F6377;
+  --accent: #22D3EE; --accent-hover: #67E8F9; --accent-soft: rgba(34,211,238,.14); --accent-muted: rgba(34,211,238,.07);
+  --backdrop: rgba(2, 8, 16, 0.65);
+  --shadow-xs: 0 1px 2px rgba(0,0,0,.3); --shadow-sm: 0 2px 6px rgba(0,0,0,.35);
+  --shadow-md: 0 8px 24px rgba(0,0,0,.4); --shadow-lg: 0 20px 48px rgba(0,0,0,.5);
+  --shadow-drawer: 0 20px 48px rgba(0,0,0,.6);
+  color-scheme: dark;
+}
+
+/* Dark: Forest — moss-on-pine, dark with green pulse */
+:root[data-theme="forest"] {
+  --bg: #08110D; --surface: #11201A; --surface-raised: #172821; --surface-soft: #1F3329;
+  --border: rgba(132, 204, 173, 0.07); --border-strong: rgba(132, 204, 173, 0.14);
+  --ink: #E5F2EB; --ink-soft: #BFD2C5; --muted: #7C9989; --muted-soft: #54705F;
+  --accent: #84CC16; --accent-hover: #A3E635; --accent-soft: rgba(132,204,22,.14); --accent-muted: rgba(132,204,22,.07);
+  --backdrop: rgba(0, 8, 4, 0.65);
+  --shadow-xs: 0 1px 2px rgba(0,0,0,.3); --shadow-sm: 0 2px 6px rgba(0,0,0,.35);
+  --shadow-md: 0 8px 24px rgba(0,0,0,.4); --shadow-lg: 0 20px 48px rgba(0,0,0,.5);
+  --shadow-drawer: 0 20px 48px rgba(0,0,0,.6);
+  color-scheme: dark;
+}
+
+/* Dark: Wine — warm dark with rose */
+:root[data-theme="wine"] {
+  --bg: #110509; --surface: #1F0C13; --surface-raised: #2A1019; --surface-soft: #381522;
+  --border: rgba(251, 207, 232, 0.07); --border-strong: rgba(251, 207, 232, 0.14);
+  --ink: #F2E5EA; --ink-soft: #D5BFC8; --muted: #A57885; --muted-soft: #75545D;
+  --accent: #F472B6; --accent-hover: #F9A8D4; --accent-soft: rgba(244,114,182,.14); --accent-muted: rgba(244,114,182,.07);
+  --backdrop: rgba(20, 0, 8, 0.65);
+  --shadow-xs: 0 1px 2px rgba(0,0,0,.3); --shadow-sm: 0 2px 6px rgba(0,0,0,.35);
+  --shadow-md: 0 8px 24px rgba(0,0,0,.4); --shadow-lg: 0 20px 48px rgba(0,0,0,.5);
+  --shadow-drawer: 0 20px 48px rgba(0,0,0,.6);
+  color-scheme: dark;
+}
+
+/* Backwards-compat: old data-theme="dark" → midnight */
+:root[data-theme="dark"] {
+  --bg: #0A0A0B; --surface: #141416; --surface-raised: #1A1A1D; --surface-soft: #212125;
+  --border: rgba(255, 255, 255, 0.06); --border-strong: rgba(255, 255, 255, 0.12);
+  --ink: #EDEDEF; --ink-soft: #C8C9CD; --muted: #8B8C93; --muted-soft: #5E5F66;
+  --accent: #10B981; --accent-hover: #34D399; --accent-soft: rgba(16,185,129,.14); --accent-muted: rgba(16,185,129,.07);
+  --backdrop: rgba(0, 0, 0, 0.6);
+  --shadow-xs: 0 1px 2px rgba(0,0,0,.3); --shadow-sm: 0 2px 6px rgba(0,0,0,.35);
+  --shadow-md: 0 8px 24px rgba(0,0,0,.4); --shadow-lg: 0 20px 48px rgba(0,0,0,.5);
+  --shadow-drawer: 0 20px 48px rgba(0,0,0,.6);
+  color-scheme: dark;
+}
+
+/* (palette overrides removed — themes now self-contained) */
+
+/* ─────────── Base ─────────── */
+
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; overflow: hidden; }
+body {
+  font-family: var(--font);
+  color: var(--ink);
+  background: var(--bg);
+  font-size: 14px;
+  line-height: 1.55;
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+}
+
+::selection { background: var(--accent-soft); color: var(--ink); }
+
+::-webkit-scrollbar { width: 10px; height: 10px; }
+::-webkit-scrollbar-track { background: transparent; }
+::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 999px; border: 2px solid transparent; background-clip: padding-box; }
+::-webkit-scrollbar-thumb:hover { background: var(--muted-soft); background-clip: padding-box; }
+
+/* ─────────── Root ─────────── */
+
+.unified-root {
+  height: 100dvh;
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  background: var(--bg);
+}
+
+/* ─────────── Header ─────────── */
+
+.unified-header {
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-height: var(--header-h);
+  padding: 0 16px;
+  background: color-mix(in srgb, var(--bg) 82%, transparent);
+  backdrop-filter: blur(16px) saturate(1.3);
+  -webkit-backdrop-filter: blur(16px) saturate(1.3);
+  border-bottom: 1px solid var(--border);
+  z-index: 40;
+}
+
+.header-left {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 0;
+}
+.header-actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-left: auto;
+}
+
+.logo {
+  display: inline-flex;
+  align-items: center;
+  gap: 9px;
+  font-weight: 700;
+  font-size: 15px;
+  letter-spacing: -0.02em;
+  line-height: 1;
+  color: var(--ink);
+}
+.logo-img {
+  width: 26px; height: 26px;
+  border-radius: 6px;
+  object-fit: cover;
+  flex-shrink: 0;
+  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.10);
+}
+.visually-hidden {
+  position: absolute; width: 1px; height: 1px;
+  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
+}
+/* Trace icon button — overlay dot for connection state */
+#openTraceBtn { position: relative; }
+.trace-btn-dot {
+  position: absolute;
+  top: 4px; right: 4px;
+  width: 6px; height: 6px;
+  border-radius: 50%;
+  background: var(--muted-soft);
+  pointer-events: none;
+}
+.trace-btn-dot.live { background: var(--accent); box-shadow: 0 0 0 2px var(--surface); }
+.trace-btn-dot.poll { background: var(--amber); }
+
+.icon-btn, .sidebar-toggle {
+  width: 34px; height: 34px;
+  border-radius: 9px;
+  border: 1px solid var(--border);
+  background: var(--surface);
+  color: var(--muted);
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  transition: all .15s ease;
+  flex-shrink: 0;
+}
+.icon-btn:hover, .sidebar-toggle:hover {
+  color: var(--ink);
+  border-color: var(--border-strong);
+  background: var(--surface-raised);
+}
+.icon-btn svg, .sidebar-toggle svg { width: 16px; height: 16px; stroke-width: 2; }
+
+/* The ☰ sidebar-toggle state reflects rail visibility */
+body.rail-collapsed .sidebar-toggle {
+  color: var(--muted);
+  background: var(--surface);
+}
+body:not(.rail-collapsed) .sidebar-toggle {
+  color: var(--accent);
+  background: var(--accent-muted);
+  border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
+}
+
+/* Trace open button — prominent pill with icon + text */
+.trace-open-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  height: 34px;
+  padding: 0 12px;
+  border-radius: 9px;
+  border: 1px solid var(--border);
+  background: var(--surface);
+  color: var(--muted);
+  font: inherit;
+  font-size: 12.5px;
+  font-weight: 550;
+  cursor: pointer;
+  transition: all .15s;
+  position: relative;
+  white-space: nowrap;
+}
+.trace-open-btn:hover {
+  color: var(--accent);
+  border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
+  background: var(--accent-muted);
+}
+.trace-open-btn svg { flex-shrink: 0; }
+body.trace-open .trace-open-btn {
+  color: var(--accent);
+  background: var(--accent-muted);
+  border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
+}
+.trace-open-btn .trace-btn-dot {
+  position: static;
+  width: 6px; height: 6px;
+  border-radius: 50%;
+  background: var(--muted-soft);
+}
+.trace-open-btn .trace-btn-dot.live {
+  background: var(--accent);
+  box-shadow: 0 0 0 3px var(--accent-muted);
+  animation: dot-pulse 1.8s ease-in-out infinite;
+}
+.trace-open-btn .trace-btn-dot.poll { background: var(--amber); }
+
+/* A small pulsing pill on the trace button when there's fresh activity but user hasn't opened */
+.trace-open-btn.has-activity:not(:hover)::after {
+  content: '';
+  position: absolute;
+  top: 3px; right: 3px;
+  width: 7px; height: 7px;
+  border-radius: 50%;
+  background: var(--warn);
+  box-shadow: 0 0 0 2px var(--surface);
+  animation: dot-pulse 1.4s ease-in-out infinite;
+}
+
+/* Tab bar (chat / trace) */
+.tab-bar {
+  display: inline-flex;
+  align-items: center;
+  padding: 3px;
+  gap: 2px;
+  background: var(--surface-raised);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+}
+.tab-bar button {
+  border: none;
+  background: transparent;
+  color: var(--muted);
+  padding: 5px 13px;
+  border-radius: 7px;
+  font: inherit;
+  font-size: 12.5px;
+  font-weight: 550;
+  cursor: pointer;
+  transition: color .12s, background .12s;
+  white-space: nowrap;
+}
+.tab-bar button:hover { color: var(--ink); }
+.tab-bar button[aria-selected="true"] {
+  background: var(--surface);
+  color: var(--ink);
+  box-shadow: var(--shadow-xs);
+}
+
+/* Connection pills */
+.pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  height: 28px;
+  padding: 0 11px;
+  font-size: 11.5px;
+  font-weight: 500;
+  color: var(--muted);
+  border-radius: var(--radius-pill);
+  border: 1px solid var(--border);
+  background: var(--surface);
+  white-space: nowrap;
+}
+.pill .dot {
+  width: 6px; height: 6px;
+  border-radius: 50%;
+  background: var(--muted-soft);
+  flex-shrink: 0;
+}
+.dot.live {
+  background: var(--accent);
+  box-shadow: 0 0 0 3px var(--accent-muted);
+  animation: dot-pulse 1.8s ease-in-out infinite;
+}
+.dot.poll { background: var(--amber); }
+@keyframes dot-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
+.trace-pill.ok  { color: var(--accent); }
+.trace-pill.bad { color: var(--warn); }
+
+/* ─────────── Body: 3-column inline grid (rail | chat | trace) ─────────── */
+
+.unified-body {
+  flex: 1 1 0;
+  min-height: 0;
+  overflow: hidden;
+  display: grid;
+  grid-template-columns: var(--rail-w) auto minmax(0, 1fr) auto var(--trace-w);
+}
+/* Disable transition while user is dragging to keep cursor in sync */
+.unified-body:not(.is-resizing) { transition: grid-template-columns .2s cubic-bezier(0.4, 0, 0.2, 1); }
+
+/* Column toggles via body classes */
+body.rail-collapsed { --rail-w: 0px; }
+body.trace-open     { --trace-w: var(--trace-w-user, min(560px, 45vw)); }
+body:not(.trace-open) #resizerTrace { display: none; }
+body.rail-collapsed #resizerRail { display: none; }
+
+/* Vertical column resizers */
+.col-resizer {
+  width: 6px;
+  cursor: col-resize;
+  background: transparent;
+  position: relative;
+  z-index: 5;
+  user-select: none;
+  touch-action: none;
+}
+.col-resizer::before {
+  content: '';
+  position: absolute;
+  inset: 0 2px;
+  background: var(--border);
+  opacity: 0;
+  transition: opacity .15s;
+  border-radius: 2px;
+}
+.col-resizer:hover::before,
+.unified-body.is-resizing .col-resizer::before { opacity: 1; background: var(--accent); }
+.unified-body.is-resizing { cursor: col-resize; user-select: none; }
+.unified-body.is-resizing * { user-select: none; pointer-events: none; }
+.unified-body.is-resizing .col-resizer { pointer-events: auto; }
+@media (max-width: 900px) {
+  .col-resizer { display: none; }
+}
+
+.unified-layout { display: contents; }  /* legacy wrapper, collapsed */
+
+.panel {
+  display: flex;
+  flex-direction: column;
+  min-height: 0;
+  overflow: hidden;
+  position: relative;
+}
+.panel.hidden-narrow { display: none; }
+.composer-resizer { display: none !important; }
+.panel-chat { grid-column: 3 / 4; min-width: 0; }
+#resizerRail { grid-column: 2 / 3; }
+#resizerTrace { grid-column: 4 / 5; }
+
+/* Chat lives in col 2 (always visible) */
+.chat-shell {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  min-height: 0;
+}
+
+/* Thread rail — col 1 (default visible, collapse to 0 via body.rail-collapsed) */
+.thread-rail {
+  position: relative;
+  grid-column: 1 / 2;
+  width: 100%;
+  height: 100%;
+  background: color-mix(in srgb, var(--surface-raised) 60%, transparent);
+  border-right: 1px solid var(--border);
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  min-width: 0;
+}
+/* Trace panel — col 5 (default hidden, opens via body.trace-open) */
+.trace-panel {
+  grid-column: 5 / 6;
+  width: 100%;
+  height: 100%;
+  min-width: 0;
+  background: var(--surface);
+  border-left: 1px solid var(--border);
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  min-width: 0;
+}
+
+/* Narrow viewports: stack single-panel, toggle rail + trace as overlay drawers */
+@media (max-width: 900px) {
+  :root { --rail-w: 0px; --trace-w: 0px; }
+  .unified-body { grid-template-columns: 0 0 minmax(0, 1fr) 0 0; }
+
+  .thread-rail {
+    position: fixed;
+    top: var(--header-h);
+    left: 0;
+    width: min(var(--rail-w-overlay, 280px), 86vw);
+    height: calc(100dvh - var(--header-h));
+    z-index: 60;
+    background: var(--surface);
+    border-right: 1px solid var(--border);
+    box-shadow: var(--shadow-lg);
+    transform: translateX(-110%);
+    transition: transform .25s cubic-bezier(0.4, 0, 0.2, 1);
+  }
+  .thread-rail.is-open { transform: translateX(0); }
+
+  .trace-panel {
+    position: fixed;
+    top: var(--header-h);
+    right: 0;
+    width: min(var(--trace-w-overlay, 420px), 92vw);
+    height: calc(100dvh - var(--header-h));
+    z-index: 60;
+    background: var(--surface);
+    border-left: 1px solid var(--border);
+    box-shadow: var(--shadow-lg);
+    transform: translateX(110%);
+    transition: transform .25s cubic-bezier(0.4, 0, 0.2, 1);
+  }
+  body.trace-open .trace-panel { transform: translateX(0); }
+}
+
+.thread-rail-head {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 16px 16px 10px;
+  border-bottom: 1px solid var(--border);
+}
+.thread-rail-head-text { min-width: 0; flex: 1 1 auto; }
+.thread-rail-head-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
+.thread-pin-btn {
+  width: 28px; height: 28px;
+  border: 1px solid var(--border);
+  background: var(--surface);
+  border-radius: 8px;
+  color: var(--muted);
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  transition: all .15s;
+}
+.thread-pin-btn:hover { color: var(--ink); border-color: var(--border-strong); background: var(--surface-raised); }
+.thread-pin-btn[aria-pressed="true"] {
+  color: var(--accent);
+  background: var(--accent-muted);
+  border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
+}
+.thread-pin-btn svg { width: 14px; height: 14px; transition: transform .2s; }
+.thread-pin-btn[aria-pressed="true"] svg { transform: rotate(-45deg); }
+.thread-rail-label {
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 0.09em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+.thread-rail-sub {
+  margin-top: 4px;
+  font-size: 11.5px;
+  line-height: 1.5;
+  color: var(--muted-soft);
+  max-width: 22ch;
+}
+
+.thread-list {
+  flex: 1 1 0;
+  min-height: 0;
+  overflow-y: auto;
+  padding: 8px 10px 14px;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.thread-item {
+  width: 100%;
+  text-align: left;
+  border: 1px solid transparent;
+  background: transparent;
+  color: var(--ink);
+  border-radius: 9px;
+  padding: 10px 12px;
+  cursor: pointer;
+  transition: background .15s, border-color .15s;
+}
+.thread-item:hover  { background: var(--surface-raised); border-color: var(--border); }
+.thread-item.is-active {
+  background: var(--accent-muted);
+  border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
+}
+.thread-item-row {
+  display: flex; align-items: flex-start; justify-content: space-between; gap: 10px;
+}
+.thread-item-main { min-width: 0; flex: 1 1 auto; }
+.thread-item-title {
+  font-size: 13.5px;
+  font-weight: 550;
+  line-height: 1.4;
+  margin-bottom: 3px;
+  overflow: hidden;
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+}
+.thread-item-meta {
+  font-size: 11px;
+  color: var(--muted-soft);
+  display: flex;
+  gap: 8px;
+  justify-content: space-between;
+}
+.thread-item-actions {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  flex-shrink: 0;
+  opacity: 0;
+  transition: opacity .15s;
+}
+.thread-item:hover .thread-item-actions,
+.thread-item.is-active .thread-item-actions { opacity: 1; }
+.thread-action {
+  width: 24px; height: 24px;
+  border-radius: 7px;
+  border: none;
+  background: transparent;
+  color: var(--muted);
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 11px;
+  transition: color .15s, background .15s;
+}
+.thread-action:hover { color: var(--ink); background: var(--surface-raised); }
+.thread-empty {
+  padding: 18px 14px;
+  color: var(--muted-soft);
+  font-size: 12px;
+  line-height: 1.55;
+  text-align: center;
+}
+
+/* Primary button */
+button.primary {
+  border: 0;
+  border-radius: 9px;
+  padding: 8px 14px;
+  font: inherit;
+  font-size: 13px;
+  font-weight: 550;
+  background: var(--accent);
+  color: #fff;
+  cursor: pointer;
+  transition: background .15s, transform .1s;
+}
+button.primary:hover { background: var(--accent-hover); }
+button.primary:active { transform: translateY(1px); }
+button.primary:disabled { opacity: .5; cursor: wait; }
+button.primary.subtle {
+  padding: 6px 11px;
+  font-size: 12px;
+  background: var(--surface);
+  color: var(--ink);
+  border: 1px solid var(--border);
+}
+button.primary.subtle:hover { background: var(--surface-raised); border-color: var(--border-strong); }
+
+/* Drawer backdrop (shared between thread rail and settings) */
+.rail-backdrop {
+  position: fixed;
+  inset: 0;
+  background: var(--backdrop);
+  z-index: 55;
+  opacity: 0;
+  visibility: hidden;
+  transition: opacity .2s, visibility .2s;
+  backdrop-filter: blur(3px);
+}
+.rail-backdrop.is-open { opacity: 1; visibility: visible; }
+
+/* ─────────── Chat main ─────────── */
+
+.chat-main {
+  flex: 1 1 0;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  background: var(--bg);
+  overflow: hidden;
+}
+
+.chat-hero { display: none; }
+
+.chat-scroll {
+  flex: 1 1 0;
+  min-height: 0;
+  overflow-y: auto;
+  overflow-x: hidden;
+  padding: 24px 16px 8px;
+  display: flex;
+  flex-direction: column;
+  gap: 18px;
+  scroll-behavior: smooth;
+}
+
+/* Welcome empty state */
+.welcome-hero {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 16px;
+  padding: 32px 16px;
+  text-align: center;
+  max-width: 620px;
+  margin: 0 auto;
+  width: 100%;
+}
+.welcome-mark {
+  width: 72px; height: 72px;
+  border-radius: 20px;
+  display: flex; align-items: center; justify-content: center;
+  color: #fff;
+  font-size: 26px;
+  font-weight: 700;
+  box-shadow: 0 12px 32px color-mix(in srgb, var(--accent) 24%, transparent);
+}
+.welcome-mark-img {
+  object-fit: cover;
+  background: var(--surface);
+}
+.welcome-title {
+  font-size: 24px;
+  font-weight: 650;
+  letter-spacing: -0.02em;
+  line-height: 1.25;
+  margin: 0;
+}
+.welcome-sub {
+  font-size: 13.5px;
+  color: var(--muted);
+  line-height: 1.6;
+  max-width: 42ch;
+  margin: 0;
+}
+.welcome-suggestions {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 8px;
+  width: 100%;
+  max-width: 520px;
+  margin-top: 6px;
+}
+.welcome-suggestion {
+  padding: 11px 13px;
+  border: 1px solid var(--border);
+  border-radius: 11px;
+  background: var(--surface);
+  text-align: left;
+  cursor: pointer;
+  color: var(--ink);
+  transition: all .15s;
+  font: inherit;
+}
+.welcome-suggestion:hover {
+  border-color: var(--accent);
+  background: var(--accent-muted);
+  transform: translateY(-1px);
+}
+.welcome-suggestion-title {
+  font-weight: 600;
+  font-size: 13px;
+  margin-bottom: 2px;
+}
+.welcome-suggestion-desc {
+  font-size: 11.5px;
+  color: var(--muted);
+  line-height: 1.45;
+}
+
+/* Chat message bubbles */
+.bubble-row {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  max-width: var(--content-max);
+  margin: 0 auto;
+  width: 100%;
+}
+.bubble-row.user { flex-direction: row-reverse; }
+.bubble-avatar {
+  width: 30px; height: 30px;
+  border-radius: 9px;
+  flex-shrink: 0;
+  display: flex; align-items: center; justify-content: center;
+  font-size: 13px;
+  font-weight: 650;
+  color: #fff;
+  margin-top: 2px;
+  user-select: none;
+}
+.bubble-row.bot .bubble-avatar  {
+  background: var(--surface);
+  color: var(--accent);
+  border: 1px solid var(--border);
+  padding: 2px;
+  background-image: url('/favicon.jpg');
+  background-size: cover;
+  background-position: center;
+  font-size: 0;          /* hide the "B" character */
+}
+.bubble-row.user .bubble-avatar {
+  background: var(--accent);
+  color: #fff;
+  border: 1px solid color-mix(in srgb, var(--accent) 50%, var(--border));
+}
+
+.bubble {
+  max-width: min(100%, 640px);
+  border-radius: var(--radius);
+  padding: 12px 16px;
+  min-width: 0;
+  word-break: break-word;
+}
+.bubble.user {
+  background: var(--accent-muted);
+  border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border));
+  color: var(--ink);
+}
+.bubble.bot {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  box-shadow: var(--shadow-xs);
+}
+.bubble.is-streaming .content::after {
+  content: '▍';
+  display: inline-block;
+  color: var(--accent);
+  animation: cursor-blink 1s step-end infinite;
+  margin-left: 2px;
+  font-weight: 400;
+}
+@keyframes cursor-blink { 50% { opacity: 0; } }
+
+/* ── Streaming bubble: process strip + answer ── */
+
+.streaming-process {
+  background: color-mix(in srgb, var(--surface-raised) 65%, transparent);
+  border: 1px solid var(--border);
+  border-left: 3px solid color-mix(in srgb, var(--accent) 70%, var(--border));
+  border-radius: var(--radius-sm);
+  padding: 6px 10px 8px;
+  margin-bottom: 10px;
+  font-size: 12px;
+}
+.streaming-process > summary {
+  list-style: none;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 2px 0;
+  user-select: none;
+}
+.streaming-process > summary::-webkit-details-marker { display: none; }
+.streaming-process > summary::before {
+  content: '▾';
+  font-size: 10px;
+  color: var(--muted);
+  transition: transform .15s;
+}
+.streaming-process:not([open]) > summary::before { transform: rotate(-90deg); }
+.streaming-process-label {
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  font-size: 10.5px;
+  color: var(--accent);
+}
+.streaming-process-count {
+  margin-left: auto;
+  color: var(--muted);
+  font-size: 10.5px;
+}
+.streaming-process-body {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  margin-top: 6px;
+  padding-left: 2px;
+}
+.ss-step {
+  display: flex;
+  align-items: flex-start;
+  gap: 6px;
+  font-size: 12px;
+  line-height: 1.5;
+  color: var(--ink-muted);
+  padding: 2px 0;
+}
+.ss-step .ss-icon {
+  flex-shrink: 0;
+  width: 16px;
+  text-align: center;
+  font-size: 11.5px;
+  margin-top: 1px;
+}
+.ss-step .ss-text {
+  flex: 1 1 auto;
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+.ss-step.ss-tool .ss-text b {
+  color: var(--accent);
+  font-weight: 600;
+  margin-right: 4px;
+}
+.ss-step.ss-tool code {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  font-size: 11px;
+  background: color-mix(in srgb, var(--accent-soft) 50%, transparent);
+  padding: 1px 5px;
+  border-radius: 3px;
+}
+.ss-step.ss-think .ss-text { color: var(--ink-muted); font-style: italic; }
+.ss-step.ss-spawn .ss-text { color: var(--ink-muted); }
+.ss-step.ss-ipc .ss-text { color: var(--ink-muted); }
+
+/* Answer area — visually clearly separated as the actual response */
+.streaming-answer {
+  position: relative;
+  padding-top: 4px;
+}
+.streaming-answer-label {
+  font-size: 10.5px;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: var(--accent);
+  margin-bottom: 6px;
+}
+.streaming-answer-body {
+  font-size: 14.5px;
+  line-height: 1.6;
+  color: var(--ink);
+}
+.streaming-answer-body p { margin: 0 0 8px; }
+.streaming-answer-body p:last-child { margin-bottom: 0; }
+
+/* Inline "thinking" pill — small status hint shown in the meta row of a streaming bubble */
+.thinking-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 2px 9px;
+  font-size: 11px;
+  font-weight: 550;
+  color: var(--accent);
+  background: var(--accent-muted);
+  border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border));
+  border-radius: 999px;
+  margin-left: 4px;
+}
+.thinking-pill.is-done {
+  color: var(--muted);
+  background: var(--surface-raised);
+  border-color: var(--border);
+}
+.thinking-pill-spinner {
+  width: 9px; height: 9px;
+  border-radius: 50%;
+  border: 1.5px solid color-mix(in srgb, var(--accent) 40%, transparent);
+  border-top-color: var(--accent);
+  animation: spin 0.8s linear infinite;
+}
+.thinking-pill-label { font-variant-numeric: tabular-nums; }
+
+/* "View trace" inline button in the meta row */
+.trace-jump-btn {
+  margin-left: auto;
+  border: 1px solid var(--border);
+  background: transparent;
+  color: var(--muted);
+  font: inherit;
+  font-size: 11px;
+  font-weight: 500;
+  padding: 3px 9px;
+  border-radius: 999px;
+  cursor: pointer;
+  transition: all .15s;
+}
+.trace-jump-btn:hover {
+  color: var(--accent);
+  border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
+  background: var(--accent-muted);
+}
+
+/* Inline agent-steps (thinking / tool_use / ipc cards rendered inline in the bubble) */
+.inline-steps {
+  margin: -4px 0 10px;
+  border-radius: 9px;
+  background: var(--surface-raised);
+  border: 1px solid var(--border);
+  font-size: 12px;
+}
+.inline-steps[open] { padding-bottom: 4px; }
+.inline-steps summary {
+  cursor: pointer;
+  list-style: none;
+  padding: 8px 12px;
+  color: var(--muted);
+  font-weight: 550;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  user-select: none;
+}
+.inline-steps summary::-webkit-details-marker { display: none; }
+.inline-steps summary::before {
+  content: '▸';
+  font-size: 10px;
+  transition: transform .15s;
+  flex-shrink: 0;
+}
+.inline-steps[open] summary::before { transform: rotate(90deg); }
+.inline-steps-label { color: var(--ink-soft); font-weight: 600; }
+.inline-steps-count { color: var(--muted-soft); font-weight: 500; font-variant-numeric: tabular-nums; }
+.inline-steps-list {
+  padding: 4px 12px 8px;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+.inline-step {
+  display: flex;
+  align-items: flex-start;
+  gap: 8px;
+  padding: 6px 8px;
+  border-radius: 7px;
+  background: var(--surface);
+  border: 1px solid var(--border);
+}
+.inline-step-icon {
+  width: 22px; height: 22px;
+  border-radius: 6px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 12px;
+  flex-shrink: 0;
+}
+.inline-step-thinking .inline-step-icon { background: var(--purple-soft); color: var(--purple); }
+.inline-step-tool .inline-step-icon    { background: var(--amber-soft);  color: var(--amber); }
+.inline-step-ipc .inline-step-icon     { background: var(--accent-soft); color: var(--accent); }
+.inline-step-spawn .inline-step-icon   { background: var(--info-soft);   color: var(--info); }
+.inline-step-err .inline-step-icon     { background: var(--warn-soft);   color: var(--warn); }
+.inline-step-body { flex: 1; min-width: 0; }
+.inline-step-label {
+  font-size: 12px;
+  font-weight: 600;
+  color: var(--ink);
+  line-height: 1.35;
+}
+.inline-step-tool .inline-step-label { font-family: var(--font-mono); font-weight: 550; color: var(--amber); }
+.inline-step-detail {
+  margin-top: 3px;
+  font-size: 11.5px;
+  color: var(--muted);
+  line-height: 1.5;
+  white-space: pre-wrap;
+  word-break: break-word;
+  font-family: var(--font-mono);
+  max-height: 140px;
+  overflow-y: auto;
+}
+
+.meta {
+  font-size: 11px;
+  color: var(--muted);
+  margin-bottom: 6px;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.meta .copy-btn {
+  margin-left: auto;
+  border: 1px solid var(--border);
+  background: transparent;
+  color: var(--muted);
+  font-size: 11px;
+  padding: 3px 8px;
+  border-radius: var(--radius-pill);
+  cursor: pointer;
+  transition: all .15s;
+}
+.meta .copy-btn:hover { color: var(--ink); border-color: var(--border-strong); background: var(--surface-raised); }
+
+.badge {
+  font-size: 10px;
+  font-weight: 600;
+  padding: 2px 8px;
+  border-radius: 6px;
+  background: var(--surface-raised);
+  border: 1px solid var(--border);
+  color: var(--muted);
+}
+
+/* Markdown content */
+.content {
+  font-size: 14px;
+  line-height: 1.6;
+  color: var(--ink);
+  word-break: break-word;
+  overflow-x: auto;
+}
+.content > :first-child { margin-top: 0; }
+.content > :last-child { margin-bottom: 0; }
+.content a { color: var(--accent); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); }
+.content a:hover { border-bottom-color: var(--accent); }
+.content p { margin: 0 0 0.65em; }
+.content pre {
+  margin: 0;
+  padding: 12px 14px;
+  border-radius: var(--radius-sm);
+  background: var(--surface-raised);
+  border: 1px solid var(--border);
+  overflow-x: auto;
+  font-family: var(--font-mono);
+  font-size: 12.5px;
+  line-height: 1.5;
+}
+
+/* Code block wrapper with copy button */
+.codeblock {
+  position: relative;
+  margin: 0.6em 0;
+}
+.codeblock-copy {
+  position: absolute;
+  top: 6px;
+  right: 6px;
+  padding: 4px 9px;
+  font: inherit;
+  font-size: 11px;
+  font-weight: 550;
+  border: 1px solid var(--border);
+  background: var(--surface);
+  color: var(--muted);
+  border-radius: 6px;
+  cursor: pointer;
+  opacity: 0;
+  transition: opacity .15s, color .15s, border-color .15s, background .15s;
+}
+.codeblock:hover .codeblock-copy { opacity: 1; }
+.codeblock-copy:hover { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 35%, var(--border)); background: var(--accent-muted); }
+
+/* Bubble footer actions (per-message copy) */
+.bubble-actions {
+  display: flex;
+  gap: 6px;
+  margin-top: 10px;
+  padding-top: 8px;
+  border-top: 1px dashed color-mix(in srgb, var(--border) 80%, transparent);
+}
+.bubble-action-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  padding: 4px 9px;
+  font: inherit;
+  font-size: 11.5px;
+  font-weight: 500;
+  border: 1px solid var(--border);
+  background: transparent;
+  color: var(--muted);
+  border-radius: 6px;
+  cursor: pointer;
+  transition: all .15s;
+}
+.bubble-action-btn:hover {
+  color: var(--accent);
+  border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
+  background: var(--accent-muted);
+}
+.bubble-action-btn svg { width: 12px; height: 12px; }
+.content code {
+  font-family: var(--font-mono);
+  font-size: 0.88em;
+  padding: 0.12em 0.4em;
+  border-radius: 5px;
+  background: var(--surface-raised);
+  border: 1px solid var(--border);
+}
+.content pre code { padding: 0; border: none; background: transparent; font-size: inherit; }
+.content ul, .content ol { margin: 0.35em 0 0.75em; padding-left: 1.35em; }
+.content li { margin: 0.25em 0; }
+.content blockquote {
+  margin: 0.6em 0;
+  padding: 0.2em 14px;
+  border-left: 3px solid var(--accent);
+  background: var(--accent-muted);
+  color: var(--ink-soft);
+  border-radius: 0 6px 6px 0;
+}
+.content h1, .content h2, .content h3, .content h4 {
+  margin: 1em 0 0.4em;
+  font-weight: 650;
+  line-height: 1.3;
+}
+.content h1 { font-size: 1.3em; }
+.content h2 { font-size: 1.18em; }
+.content h3 { font-size: 1.08em; }
+.content h4 { font-size: 1em; }
+.content h1:first-child, .content h2:first-child, .content h3:first-child, .content h4:first-child { margin-top: 0; }
+.content table {
+  border-collapse: collapse;
+  margin: 0.6em 0;
+  font-size: 13px;
+  width: 100%;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  overflow: hidden;
+}
+.content th, .content td { border: 1px solid var(--border); padding: 7px 12px; text-align: left; vertical-align: top; }
+.content th { background: var(--surface-raised); font-weight: 600; }
+.content hr { border: none; border-top: 1px solid var(--border); margin: 1em 0; }
+.content img { max-width: 100%; height: auto; border-radius: var(--radius-sm); }
+
+/* Work status strip (above composer) */
+.work-strip {
+  flex-shrink: 0;
+  display: none;
+  align-items: center;
+  gap: 12px;
+  padding: 9px 14px;
+  margin: 0 auto 10px;
+  max-width: var(--content-max);
+  width: calc(100% - 24px);
+  font-size: 12.5px;
+  color: var(--ink-soft);
+  background: var(--accent-muted);
+  border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--border));
+  border-radius: 11px;
+}
+.work-strip.is-active { display: flex; }
+.work-strip.is-error {
+  color: var(--warn);
+  background: var(--warn-soft);
+  border-color: color-mix(in srgb, var(--warn) 20%, var(--border));
+}
+.work-strip-spinner {
+  width: 14px; height: 14px;
+  border-radius: 50%;
+  border: 2px solid color-mix(in srgb, var(--accent) 30%, transparent);
+  border-top-color: var(--accent);
+  animation: spin 0.8s linear infinite;
+  flex-shrink: 0;
+}
+.work-strip.is-error .work-strip-spinner { border-color: var(--warn); border-top-color: transparent; animation: none; }
+@keyframes spin { to { transform: rotate(360deg); } }
+.work-strip-label { font-weight: 600; }
+.work-strip-detail {
+  color: var(--muted);
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.work-strip-time {
+  font-variant-numeric: tabular-nums;
+  color: var(--muted);
+  font-size: 11.5px;
+}
+
+/* Composer */
+.composer-wrap {
+  flex-shrink: 0;
+  flex-grow: 0;
+  min-height: 80px;
+  padding: 0 16px 16px;
+  position: relative;
+  z-index: 10;
+}
+.composer-card {
+  max-width: var(--content-max);
+  margin: 0 auto;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  box-shadow: var(--shadow-sm);
+  padding: 8px 10px 10px;
+  transition: border-color .15s, box-shadow .15s;
+}
+.composer-card:focus-within {
+  border-color: color-mix(in srgb, var(--accent) 45%, var(--border-strong));
+  box-shadow: 0 0 0 3px var(--accent-soft), var(--shadow-sm);
+}
+.composer-input-shell { display: flex; flex-direction: column; gap: 6px; }
+
+textarea {
+  width: 100%;
+  min-height: 44px;
+  max-height: 40vh;
+  resize: none;
+  border: none;
+  padding: 8px 10px 2px;
+  font: inherit;
+  font-size: 14.5px;
+  line-height: 1.55;
+  background: transparent;
+  color: var(--ink);
+  overflow: auto;
+}
+textarea:focus { outline: none; }
+textarea::placeholder { color: var(--muted-soft); }
+
+.row {
+  display: flex;
+  gap: 10px;
+  justify-content: space-between;
+  align-items: center;
+  flex-wrap: wrap;
+  padding: 0 2px;
+}
+.hint { color: var(--muted-soft); font-size: 11.5px; max-width: 36ch; }
+.toolbar { display: flex; gap: 4px; align-items: center; }
+
+.upload {
+  position: relative;
+  overflow: hidden;
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  border-radius: 9px;
+  padding: 6px 10px;
+  border: 1px solid transparent;
+  background: transparent;
+  cursor: pointer;
+  font-size: 12.5px;
