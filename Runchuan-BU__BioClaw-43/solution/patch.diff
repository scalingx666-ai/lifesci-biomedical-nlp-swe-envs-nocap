+  color: var(--accent);
+}
+.files-tree-empty, .files-tree-loading {
+  color: var(--muted);
+  padding: 8px 4px;
+  font-size: 12px;
+}
+.files-tree details { margin: 2px 0; }
+.files-tree summary {
+  cursor: pointer;
+  padding: 3px 4px;
+  border-radius: 4px;
+  list-style: none;
+  user-select: none;
+}
+.files-tree summary::-webkit-details-marker { display: none; }
+.files-tree summary:hover { background: var(--surface-raised); }
+.files-tree .ft-children { padding-left: 14px; }
+.files-tree .ft-file {
+  cursor: pointer;
+  padding: 3px 6px;
+  border-radius: 4px;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  user-select: none;
+}
+.files-tree .ft-file:hover { background: var(--surface-raised); }
+.files-tree .ft-file.is-active {
+  background: var(--accent-soft);
+  color: var(--accent);
+  font-weight: 600;
+}
+
+.files-preview {
+  flex: 1 1 0;
+  min-height: 0;
+  overflow: auto;
+  display: flex;
+  flex-direction: column;
+  background: var(--surface);
+}
+.files-preview[hidden] { display: none; }
+.files-preview-empty {
+  color: var(--muted);
+  padding: 24px 16px;
+  font-size: 13px;
+  text-align: center;
+}
+.files-preview-header {
+  flex-shrink: 0;
+  display: none;
+}
+.files-preview-actions-bar {
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 10px 16px;
+  border-bottom: 1px solid var(--border);
+  background: color-mix(in srgb, var(--surface-raised) 40%, transparent);
+}
+.files-preview-path {
+  flex: 1 1 0;
+  min-width: 0;
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  font-size: 11px;
+  color: var(--muted);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.files-preview-name {
+  font-size: 12.5px;
+  font-weight: 650;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.files-preview-actions { display: flex; gap: 6px; flex-shrink: 0; }
+.files-preview-body {
+  flex: 1 1 0;
+  min-height: 0;
+  overflow: auto;
+  padding: 12px 16px;
+}
+.files-preview-image {
+  display: flex;
+  align-items: flex-start;
+  justify-content: center;
+}
+.files-preview-image img {
+  max-width: 100%;
+  height: auto;
+  border-radius: var(--radius-sm);
+  box-shadow: var(--shadow-sm);
+}
+.files-preview-code {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  font-size: 12px;
+  line-height: 1.55;
+  white-space: pre;
+  margin: 0;
+  color: var(--ink);
+  background: color-mix(in srgb, var(--surface-raised) 50%, transparent);
+  padding: 12px;
+  border-radius: var(--radius-sm);
+  border: 1px solid var(--border);
+  overflow: auto;
+}
+
+/* ─────────── Lab trace panel (inside drawer) ─────────── */
+
+.trace-toolbar {
+  padding: 14px 16px;
+  border-bottom: 1px solid var(--border);
+  flex-shrink: 0;
+  background: var(--surface);
+}
+.trace-opt {
+  font-size: 12.5px;
+  color: var(--muted);
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  cursor: pointer;
+  user-select: none;
+}
+.trace-opt input { accent-color: var(--accent); cursor: pointer; }
+.trace-desc { margin: 0 0 10px; font-size: 12.5px; color: var(--muted); line-height: 1.5; max-width: var(--content-max); }
+.trace-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
+.fld { font-size: 12.5px; color: var(--muted); display: flex; align-items: center; gap: 8px; }
+.fld select, .btn-trace {
+  background: var(--surface);
+  color: var(--ink);
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  padding: 6px 10px;
+  font: inherit;
+  font-size: 12.5px;
+  cursor: pointer;
+}
+.btn-trace:hover { border-color: var(--accent); color: var(--accent); }
+
+.trace-main {
+  flex: 1 1 0;
+  min-height: 0;
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+}
+.timeline {
+  flex: 1 1 0;
+  padding: 14px 16px;
+  min-height: 0;
+  overflow-y: auto;
+}
+.trace-sidebar {
+  flex-shrink: 0;
+  border-top: 1px solid var(--border);
+  padding: 12px 16px;
+  max-height: 35%;
+  overflow-y: auto;
+  background: color-mix(in srgb, var(--surface-raised) 50%, transparent);
+}
+
+/* Trace task cards / process steps */
+.task-card { border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 10px; background: var(--surface); overflow: hidden; }
+.task-card.is-running { border-color: color-mix(in srgb, var(--user) 40%, var(--border)); }
+.task-card.is-error   { border-color: color-mix(in srgb, var(--warn) 40%, var(--border)); }
+.task-card.is-highlighted {
+  border-color: var(--accent);
+  box-shadow: 0 0 0 3px var(--accent-soft);
+  animation: trace-flash 1.6s ease-out;
+}
+@keyframes trace-flash {
+  0%   { background: var(--accent-muted); }
+  100% { background: var(--surface); }
+}
+.task-header { display: flex; align-items: flex-start; gap: 10px; padding: 11px 14px; cursor: pointer; user-select: none; }
+.task-header:hover { background: var(--surface-raised); }
+.task-status { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; }
+.task-status.ok { background: var(--accent); }
+.task-status.err { background: var(--warn); }
+.task-status.running { background: var(--user); animation: dot-pulse 1.2s ease-in-out infinite; }
+.task-chevron { width: 14px; height: 14px; flex-shrink: 0; margin-top: 3px; transition: transform .2s; color: var(--muted); }
+.task-card[open] .task-chevron { transform: rotate(90deg); }
+.task-info { flex: 1; min-width: 0; }
+.task-prompt { font-size: 13.5px; font-weight: 600; color: var(--ink); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+.task-meta { margin-top: 4px; font-size: 11px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 4px 10px; font-variant-numeric: tabular-nums; }
+.task-body { padding: 8px 14px 14px; }
+
+.response-bubble { border: 1px solid var(--border); border-radius: var(--radius-sm); margin-top: 8px; background: var(--surface-raised); overflow: hidden; }
+.ipc-divider { display: flex; align-items: center; gap: 8px; margin: 12px 0; padding: 0 4px; }
+.ipc-divider-line { flex: 1; height: 1px; background: var(--border); }
+.ipc-divider-label { font-size: 11px; color: var(--muted); white-space: nowrap; max-width: 300px; overflow: hidden; text-overflow: ellipsis; }
+.response-content { padding: 12px 14px; font-size: 13px; line-height: 1.55; }
+.response-content pre { background: var(--bg); border-radius: 7px; padding: 10px 12px; overflow-x: auto; font-size: 12px; }
+.response-content code { font-family: var(--font-mono); font-size: 0.9em; }
+.response-content img { max-width: 100%; height: auto; border-radius: var(--radius-sm); }
+.response-content table { border-collapse: collapse; margin: 0.5em 0; font-size: 12px; width: 100%; }
+.response-content th, .response-content td { border: 1px solid var(--border); padding: 5px 8px; text-align: left; }
+.response-content th { background: var(--bg); font-weight: 600; }
+.response-error { padding: 10px 14px; font-size: 12px; color: var(--warn); border-top: 1px solid color-mix(in srgb, var(--warn) 20%, var(--border)); background: var(--warn-soft); }
+.response-running { padding: 10px 14px; font-size: 12px; color: var(--user); text-align: center; }
+
+.process-steps { border-bottom: 1px solid var(--border); }
+.process-steps summary { padding: 8px 14px; font-size: 11px; color: var(--muted); cursor: pointer; user-select: none; display: flex; align-items: center; gap: 6px; list-style: none; }
+.process-steps summary::-webkit-details-marker { display: none; }
+.process-steps summary::before { content: '▸'; display: inline-block; transition: transform .15s; font-size: 10px; }
+.process-steps[open] summary::before { transform: rotate(90deg); }
+.process-steps-list { padding: 0 14px 8px; }
+.pstep { display: flex; align-items: flex-start; gap: 8px; padding: 4px 0; font-size: 11px; line-height: 1.4; }
+.pstep + .pstep { border-top: 1px solid color-mix(in srgb, var(--border) 40%, transparent); }
+.pstep-icon { width: 18px; height: 18px; border-radius: 5px; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 700; flex-shrink: 0; margin-top: 1px; }
+.pstep-icon.think { background: var(--purple-soft); color: var(--purple); }
+.pstep-icon.tool  { background: var(--amber-soft); color: var(--amber); }
+.pstep-icon.ipc   { background: var(--accent-soft); color: var(--accent); }
+.pstep-icon.spawn { background: var(--info-soft); color: var(--info); }
+.pstep-icon.err   { background: var(--warn-soft); color: var(--warn); }
+.pstep-body { flex: 1; min-width: 0; }
+.pstep-label { font-weight: 600; color: var(--ink); }
+.pstep-time { font-size: 10px; color: var(--muted); margin-left: 6px; font-variant-numeric: tabular-nums; }
+.pstep-detail { color: var(--muted); margin-top: 2px; white-space: pre-wrap; word-break: break-word; font-size: 10.5px; }
+.pstep-detail.short { max-height: 60px; overflow: hidden; }
+.pstep-collapse { margin-top: 2px; }
+.pstep-collapse summary { cursor: pointer; font-size: 10.5px; color: var(--accent); list-style: none; user-select: none; }
+.pstep-collapse summary::-webkit-details-marker { display: none; }
+.pstep-collapse summary::before { content: '▶ '; font-size: 8px; }
+.pstep-collapse[open] summary::before { content: '▼ '; font-size: 8px; }
+.pstep-collapse-body { color: var(--muted); font-size: 10.5px; white-space: pre-wrap; word-break: break-word; max-height: 300px; overflow-y: auto; margin-top: 2px; padding: 5px 7px; background: color-mix(in srgb, var(--surface) 60%, transparent); border-radius: 5px; }
+.pstep-tool-name { font-family: var(--font-mono); font-weight: 600; }
+
+.evt-standalone { font-size: 12px; padding: 9px 13px; margin-bottom: 6px; border-left: 3px solid var(--border-strong); background: var(--surface-raised); border-radius: 7px; }
+.evt-standalone .evt-s-header { display: flex; align-items: center; gap: 6px; }
+.evt-standalone .evt-s-icon { width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; flex-shrink: 0; }
+.evt-standalone .evt-s-title { font-weight: 600; font-size: 12px; }
+.evt-standalone .evt-s-time { opacity: .5; font-size: 10px; margin-left: auto; }
+.evt-standalone .evt-s-detail { color: var(--muted); font-size: 11px; white-space: pre-wrap; word-break: break-word; max-height: 120px; overflow-y: auto; margin-top: 4px; padding-left: 26px; }
+.evt-standalone details.evt-s-collapse { margin-top: 4px; padding-left: 26px; }
+.evt-standalone details.evt-s-collapse summary { cursor: pointer; font-size: 11px; color: var(--accent); list-style: none; user-select: none; }
+.evt-standalone details.evt-s-collapse summary::-webkit-details-marker { display: none; }
+.evt-standalone details.evt-s-collapse summary::before { content: '▶ '; font-size: 9px; }
+.evt-standalone details.evt-s-collapse[open] summary::before { content: '▼ '; }
+.evt-standalone .evt-s-collapse-body { color: var(--muted); font-size: 11px; white-space: pre-wrap; word-break: break-word; max-height: 300px; overflow-y: auto; margin-top: 4px; padding: 6px 8px; background: color-mix(in srgb, var(--surface) 60%, transparent); border-radius: 5px; }
+
+.evt-badge { display: inline-block; font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.04em; }
+.evt-badge.ok { background: var(--accent-soft); color: var(--accent); }
+.evt-badge.err { background: var(--warn-soft); color: var(--warn); }
+.evt-mono { font-family: var(--font-mono); font-size: 11px; word-break: break-all; }
+.evt-raw { margin-top: 10px; font-size: 11px; color: var(--muted); }
+.evt-raw summary { cursor: pointer; user-select: none; }
+.evt-raw pre { margin: 8px 0 0; font-size: 11px; color: var(--muted); white-space: pre-wrap; word-break: break-all; max-height: 200px; overflow: auto; font-family: var(--font-mono); padding: 8px; border-radius: 7px; background: var(--bg); border: 1px solid var(--border); }
+.tpill { display: inline-block; font-size: 10px; padding: 2px 8px; border-radius: 6px; background: var(--surface-raised); border: 1px solid var(--border); margin-right: 6px; }
+.sidebar-title { font-size: 13px; font-weight: 650; }
+.sidebar-hint { color: var(--muted); font-size: 12px; line-height: 1.45; margin: 8px 0; }
+.tree { font-size: 12px; color: var(--muted); }
+.tree details { margin: 4px 0 4px 8px; }
+.tree summary { cursor: pointer; color: var(--ink); }
+
+/* ─────────── Settings drawer (right) ─────────── */
+
+.drawer-backdrop {
+  position: fixed;
+  inset: 0;
+  background: var(--backdrop);
+  z-index: 100;
+  opacity: 0;
+  visibility: hidden;
+  transition: opacity .2s, visibility .2s;
+  backdrop-filter: blur(4px);
+}
+.drawer-backdrop.is-open { opacity: 1; visibility: visible; }
+
+.drawer {
+  position: fixed;
+  top: 0; right: 0;
+  width: min(100%, var(--drawer-w));
+  height: 100%;
+  z-index: 101;
+  background: var(--surface);
+  border-left: 1px solid var(--border);
+  box-shadow: var(--shadow-drawer);
+  transform: translateX(100%);
+  transition: transform .28s cubic-bezier(0.4, 0, 0.2, 1);
+  display: flex;
+  flex-direction: column;
+}
+.drawer.is-open { transform: translateX(0); }
+.drawer-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 18px 20px;
+  border-bottom: 1px solid var(--border);
+}
+.drawer-head h2 { margin: 0; font-size: 17px; font-weight: 650; letter-spacing: -0.015em; }
+.drawer-body { padding: 16px 20px 28px; overflow-y: auto; flex: 1; }
+.drawer-section { margin-bottom: 24px; }
+.drawer-section-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
+.drawer-section h3 { margin: 0 0 10px; font-size: 10.5px; font-weight: 650; text-transform: uppercase; letter-spacing: .09em; color: var(--muted); }
+.drawer-section-head h3 { margin-bottom: 0; }
+
+.setting-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 11px 0;
+  border-bottom: 1px solid var(--border);
+}
+.setting-row:last-child { border-bottom: none; }
+.setting-stack { display: flex; flex-direction: column; gap: 8px; padding: 10px 0; }
+.setting-inline { display: flex; align-items: center; gap: 8px; }
+.setting-label { font-size: 13.5px; color: var(--ink); }
+.setting-value { font-size: 13px; color: var(--muted); }
+
+.btn-setting {
+  border: 1px solid var(--border);
+  background: var(--surface);
+  color: var(--ink);
+  border-radius: 9px;
+  padding: 7px 13px;
+  font: inherit;
+  font-size: 13px;
+  cursor: pointer;
+  transition: all .15s;
+}
+.btn-setting:hover { border-color: var(--accent); color: var(--accent); }
+.btn-inline { padding: 6px 10px; font-size: 12px; white-space: nowrap; }
+
+/* Unified theme picker — 9 self-contained themes (5 light + 4 dark) */
+.theme-grid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 8px;
+}
+.theme-swatch {
+  position: relative;
+  border-radius: 10px;
+  border: 2px solid transparent;
+  background: var(--surface-raised);
+  cursor: pointer;
+  padding: 0;
+  overflow: hidden;
+  transition: transform .1s, border-color .15s, box-shadow .15s;
+  font: inherit;
+  display: flex;
+  flex-direction: column;
+}
+.theme-swatch:hover { transform: translateY(-1px); box-shadow: var(--shadow-sm); }
+.theme-swatch.is-active {
+  border-color: var(--accent);
+  box-shadow: 0 0 0 3px var(--accent-soft);
+}
+.theme-swatch-preview {
+  display: block;
+  height: 56px;
+  background: var(--swatch-bg, #fff);
+  position: relative;
+  border-radius: 8px 8px 0 0;
+}
+.theme-swatch-preview::after {
+  /* small accent dot showing the accent color */
+  content: '';
+  position: absolute;
+  bottom: 7px; right: 7px;
+  width: 14px; height: 14px;
+  border-radius: 50%;
+  background: var(--swatch-accent, #10B981);
+  box-shadow: 0 0 0 2px var(--swatch-bg, #fff);
+}
+.theme-swatch-preview::before {
+  /* faux chat-bubble outline to make it feel like a screenshot */
+  content: '';
+  position: absolute;
+  left: 7px; right: 28px; top: 9px; height: 8px;
+  border-radius: 4px;
+  background: var(--swatch-bubble, rgba(0,0,0,0.08));
+}
+.theme-swatch-label {
+  display: block;
+  padding: 6px 4px 7px;
+  font-size: 11px;
+  font-weight: 550;
+  text-align: center;
+  color: var(--ink-soft);
+  background: var(--surface);
+}
+.theme-swatch[data-mode="dark"] .theme-swatch-label { color: var(--ink-soft); }
+
+/* Per-theme preview swatches (bg + accent) */
+.theme-swatch[data-theme="default"]    { --swatch-bg: #FAFAF7; --swatch-accent: #059669; --swatch-bubble: rgba(0,0,0,0.07); }
+.theme-swatch[data-theme="ocean"]      { --swatch-bg: #F1F7FA; --swatch-accent: #0891B2; --swatch-bubble: rgba(8,47,73,0.1); }
+.theme-swatch[data-theme="sakura"]     { --swatch-bg: #FBF3F5; --swatch-accent: #E11D48; --swatch-bubble: rgba(76,5,25,0.1); }
+.theme-swatch[data-theme="cream"]      { --swatch-bg: #FBF6E9; --swatch-accent: #B45309; --swatch-bubble: rgba(86,64,18,0.1); }
+.theme-swatch[data-theme="mono-light"] { --swatch-bg: #FAFAFA; --swatch-accent: #171717; --swatch-bubble: rgba(0,0,0,0.1); }
+.theme-swatch[data-theme="midnight"]   { --swatch-bg: #0A0A0B; --swatch-accent: #10B981; --swatch-bubble: rgba(255,255,255,0.08); }
+.theme-swatch[data-theme="slate"]      { --swatch-bg: #0B1218; --swatch-accent: #22D3EE; --swatch-bubble: rgba(186,230,253,0.08); }
+.theme-swatch[data-theme="forest"]     { --swatch-bg: #08110D; --swatch-accent: #84CC16; --swatch-bubble: rgba(132,204,173,0.08); }
+.theme-swatch[data-theme="wine"]       { --swatch-bg: #110509; --swatch-accent: #F472B6; --swatch-bubble: rgba(251,207,232,0.08); }
+
+.manage-input {
+  width: 100%;
+  border: 1px solid var(--border);
+  background: var(--surface);
+  color: var(--ink);
+  border-radius: 9px;
+  padding: 8px 10px;
+  font: inherit;
+  font-size: 13px;
+}
+.manage-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
+.manage-block {
+  margin: 0;
+  min-height: 68px;
+  max-height: 220px;
+  overflow: auto;
+  border: 1px solid var(--border);
+  background: var(--surface-raised);
+  color: var(--ink-soft);
+  border-radius: 9px;
+  padding: 10px 12px;
+  font-family: var(--font-mono);
+  font-size: 11.5px;
+  line-height: 1.5;
+  white-space: pre-wrap;
+  word-break: break-word;
+}
+.jid-box {
+  display: block;
+  margin-top: 6px;
+  padding: 10px 12px;
+  font-family: var(--font-mono);
+  font-size: 11.5px;
+  word-break: break-all;
+  color: var(--ink-soft);
+  background: var(--surface-raised);
+  border: 1px solid var(--border);
+  border-radius: 9px;
+}
+
+/* ─────────── Narrow screen tweaks ─────────── */
+
+@media (max-width: 700px) {
+  .unified-header { padding: 0 12px; gap: 8px; min-height: 48px; }
+  .header-actions { gap: 6px; }
+  .pill { height: 26px; padding: 0 9px; font-size: 11px; }
+  .pill.trace-pill { display: none; }
+  .icon-btn, .sidebar-toggle { width: 30px; height: 30px; border-radius: 8px; }
+  .logo { font-size: 14px; gap: 8px; }
+  .logo-img { width: 22px; height: 22px; border-radius: 5px; }
+  .tab-bar button { padding: 5px 11px; font-size: 12px; }
+  .chat-scroll { padding: 16px 12px 8px; gap: 14px; }
+  .composer-wrap { padding: 0 12px 12px; }
+  .welcome-hero { padding: 24px 8px; gap: 14px; }
+  .welcome-suggestions { grid-template-columns: 1fr; }
+  .bubble-row { gap: 8px; }
+  .bubble-avatar { width: 26px; height: 26px; border-radius: 8px; font-size: 11px; }
+  .bubble { padding: 10px 13px; }
+  .composer-card { padding: 7px 9px 9px; }
+  .trace-toolbar { padding: 12px 14px; }
+  .timeline { padding: 12px 14px; }
+  .trace-sidebar { padding: 10px 14px; }
+}
+
+@media (max-width: 480px) {
+  .pill#connPill { display: none; }
+  .welcome-suggestion-desc { display: none; }
+  .welcome-mark { width: 48px; height: 48px; font-size: 22px; border-radius: 14px; }
+  .welcome-title { font-size: 20px; }
+}
