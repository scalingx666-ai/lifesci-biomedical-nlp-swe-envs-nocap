+  transition: all .15s;
+}
+.upload:hover { color: var(--ink); background: var(--surface-raised); }
+.upload input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
+.filename {
+  color: var(--muted);
+  font-size: 11.5px;
+  max-width: 120px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.status { min-height: 16px; color: var(--muted); font-size: 11.5px; margin-top: 6px; padding: 0 4px; }
+
+/* File attachments */
+.file-card { display: grid; gap: 10px; padding: 14px; border-radius: var(--radius-sm); background: var(--surface-raised); border: 1px solid var(--border); }
+.file-title { font-weight: 600; font-size: 14px; }
+.file-path { font-family: var(--font-mono); font-size: 12px; color: var(--muted); word-break: break-all; }
+.file-actions { display: flex; gap: 6px; flex-wrap: wrap; }
+.file-button {
+  display: inline-flex;
+  align-items: center;
+  min-height: 30px;
+  padding: 0 12px;
+  border-radius: 8px;
+  text-decoration: none;
+  border: 1px solid var(--border);
+  background: var(--surface);
+  color: var(--ink);
+  font-size: 12.5px;
+  transition: all .15s;
+}
+.file-button:hover { border-color: var(--accent); color: var(--accent); }
+.file-action-list { margin-top: 10px; display: grid; gap: 6px; }
+.file-action-item {
+  padding: 9px 12px;
+  border: 1px solid var(--border);
+  border-radius: 9px;
+  background: var(--surface);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+.file-action-name { font-size: 12px; color: var(--ink); word-break: break-all; font-family: var(--font-mono); }
+
+/* ─────────── Lab trace panel (inline col 3, narrow-viewport overlay) ─────────── */
+
+.trace-head {
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 12px 16px;
+  border-bottom: 1px solid var(--border);
+  background: color-mix(in srgb, var(--surface-raised) 60%, transparent);
+}
+.trace-head h2 {
+  margin: 0;
+  font-size: 14px;
+  font-weight: 650;
+  letter-spacing: -0.01em;
+}
+.trace-panel .trace-main {
+  flex: 1 1 0;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+}
+.trace-conn-pill {
+  flex-shrink: 0;
+  border-top: 1px solid var(--border);
+  padding: 8px 16px;
+  font-size: 11px;
+  color: var(--muted);
+}
+
+/* When previewing a file, hide the trace header to give max space */
+body.drawer-preview .trace-head { display: none; }
+body.drawer-preview .trace-conn-pill { display: none; }
+
+/* ──────── Files pane (drawer preview, opens when clicking files in chat) ──────── */
+.files-pane {
+  flex: 1 1 0;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+}
+.files-pane[hidden] { display: none; }
+.files-toolbar {
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
