+}
+.files-back-btn:hover { background: var(--accent-soft); color: var(--accent); }
+
+/* Hide the unused old tree-related classes (kept for backwards-compat with other code paths) */
+.files-tree, .files-tree-empty, .files-tree-loading { display: none; }
+
+/* Natural-language summary in trace step labels */
+.pstep-natural {
+  color: var(--ink);
+  font-weight: 400;
+  font-size: 12.5px;
+}
+.pstep-natural::before { content: ''; }
+
+/* Language toggle in header (中 / EN) */
+.lang-toggle {
+  display: inline-flex;
+  border: 1px solid var(--border);
+  border-radius: 7px;
+  overflow: hidden;
+  background: var(--surface);
