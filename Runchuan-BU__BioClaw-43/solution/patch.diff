+  transition: background .12s, color .12s;
+}
+.trace-mode-btn + .trace-mode-btn { border-left: 1px solid var(--border); }
+.trace-mode-btn:hover { color: var(--ink); }
+.trace-mode-btn.is-active {
+  background: var(--accent);
+  color: #fff;
+}
+
+/* "Preview file" buttons inside trace events */
+.pstep-files {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-top: 6px;
+}
+.pstep-file-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  background: var(--surface-raised);
+  border: 1px solid var(--border);
