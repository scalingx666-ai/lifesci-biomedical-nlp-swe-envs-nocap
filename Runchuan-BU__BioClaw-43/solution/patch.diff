+.lang-btn + .lang-btn { border-left: 1px solid var(--border); }
+.lang-btn:hover { color: var(--ink); }
+.lang-btn.is-active {
+  background: var(--accent);
+  color: #fff;
+}
+
+/* Trace mode segmented toggle (Compact / Full) */
+.trace-mode-toggle {
+  display: inline-flex;
+  border: 1px solid var(--border);
+  border-radius: 7px;
+  overflow: hidden;
+  background: var(--surface);
