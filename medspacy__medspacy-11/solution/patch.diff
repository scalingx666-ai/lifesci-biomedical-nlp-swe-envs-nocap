-   "cell_type": "code",
-   "execution_count": 46,
-   "metadata": {},
-   "outputs": [],
-   "source": [
-    "from medspacy.postprocess import Postprocessor, PostprocessingRule, PostprocessingPattern\n",
-    "from medspacy.postprocess import postprocessing_functions"
