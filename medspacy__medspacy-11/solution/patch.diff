-   "metadata": {},
-   "outputs": [],
-   "source": [
-    "postprocess_rules = [\n",
-    "    # Instantiate our rule\n",
-    "    PostprocessingRule(\n",
-    "        # Pass in a list of patterns\n",
-    "        patterns=[\n",
-    "            # The pattern will check if the entitie's section is \"patient_instructions\"\n",
